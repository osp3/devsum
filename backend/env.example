# === DevSum Backend Environment Configuration ===

# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Database
MONGODB_URI=mongodb://localhost:27017/devsum

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-here-change-this-in-production

# Encrypts GitHub tokens and OpenAI keys at rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-encryption-key-here

# Authorizes the scheduled morning brief job (same value as the CRON_SECRET GitHub Actions secret)
CRON_SECRET=your-cron-secret-here

# === Shared GitHub OAuth App (Required) ===
# Create a GitHub OAuth app at: https://github.com/settings/applications/new
# Set Authorization callback URL to: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# === Optional: OpenAI Configuration ===
# DevSum's own key, used for users with access who haven't added their own key (only while billing is enabled)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna
# Max OpenAI tokens per user per UTC day on DevSum's key
AI_DAILY_TOKEN_CAP=200000

# === Billing (Stripe) ===
# Off until launch: no trials, paywall or checkout, and users keep bringing their own OpenAI key
BILLING_ENABLED=false
# Restricted key: Checkout Sessions, Customers, Customer portal (write); Subscriptions, Prices, Products (read)
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# From `stripe listen` locally, or the webhook endpoint in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=
# Comma-separated numeric GitHub user IDs with full access and no subscription (gh api users/NAME -q .id)
ADMIN_GITHUB_IDS=

# === OAuth App Setup Instructions ===
# 1. Go to GitHub Settings > Developer settings > OAuth Apps
# 2. Click "New OAuth App"
# 3. Fill in:
#    - Application name: DevSum (or your preferred name)
#    - Homepage URL: http://localhost:3000 (or your domain)
#    - Authorization callback URL: http://localhost:3000/auth/github/callback
# 4. Copy the Client ID and Client Secret to the variables above
# 5. Multiple users can authorize this same app with their GitHub accounts 